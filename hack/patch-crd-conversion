#!/usr/bin/env python3
"""Install the Cocoon conversion webhook target in generated CRDs."""

from pathlib import Path
import re


CONVERSION = """spec:
  conversion:
    strategy: Webhook
    webhook:
      conversionReviewVersions:
      - v1
      - v1beta1
      clientConfig:
        service:
          name: sandbox-webhook-service
          namespace: sandbox-system
          path: /convert
"""


def patch_crd(path: Path) -> None:
    """Patch one generated multi-version CRD in place."""
    content = path.read_text(encoding="utf-8")
    if len(re.findall(r"^\s+(?:-\s+)?name: v[0-9]", content, flags=re.MULTILINE)) < 2:
        return
    content = re.sub(
        r"^spec:\n(?:  conversion:\n(?:    .*\n)+)?",
        CONVERSION,
        content,
        count=1,
        flags=re.MULTILINE,
    )
    path.write_text(content, encoding="utf-8")


def main() -> None:
    """Patch generated CRDs in both deployment layouts."""
    root = Path(__file__).resolve().parent.parent
    for directory in (root / "k8s" / "crds", root / "helm" / "crds"):
        for path in directory.glob("*.yaml"):
            patch_crd(path)


if __name__ == "__main__":
    main()
