{
  "uid": "hot-sandbox",
  "title": "Hot Sandbox — 热 Sandbox 池",
  "tags": [
    "cocoon",
    "sandbox",
    "warmpool"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "① 池子 / Warm pool (operator)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "总量 (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(agent_sandboxes{launch_type=\"warm\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "剩余 (available)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(agent_sandboxes{launch_type=\"warm\",owned_by=\"SandboxWarmPool\",ready_condition=\"true\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "创建速度 (/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(agent_sandbox_warm_created_total[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "消耗速度 (/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(agent_sandbox_claim_controller_startup_latency_ms_count[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "池子 总量 / 剩余",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "agent_sandboxes gauge from the operator; 剩余 = owned_by=SandboxWarmPool & ready.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(agent_sandboxes{launch_type=\"warm\"})",
          "legendFormat": "总量",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(agent_sandboxes{launch_type=\"warm\",owned_by=\"SandboxWarmPool\",ready_condition=\"true\"})",
          "legendFormat": "剩余 (未被认领占用)",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "创建速度 / 消耗速度",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "创建 = agent_sandbox_warm_created_total, counted inside the operator at its create call. 消耗 = warm sandboxes handed to claims.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(agent_sandbox_warm_created_total[1m]))",
          "legendFormat": "创建 /s (warm-pool controller)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(agent_sandbox_claim_controller_startup_latency_ms_count[1m]))",
          "legendFormat": "消耗 /s (claims served)",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "② 认领 / Claims",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "认领速度 (/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "SandboxClaim rate, operator-side and client-side.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(agent_sandbox_claim_creation_total[1m]))",
          "legendFormat": "claims created /s (operator)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(sandbox_loadgen_bound_total[1m]))",
          "legendFormat": "claims served /s (client)",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "heatmap",
      "title": "认领延迟分布 (claim -> Ready)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "Client-observed distribution of warm-sandbox checkout latency.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "volc-vmp"
          },
          "expr": "sum(rate(sandbox_loadgen_claim_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "cellValues": {},
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    }
  ]
}