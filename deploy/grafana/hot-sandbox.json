    {
      "id": 19,
      "type": "heatmap",
      "title": "认领延迟分布 heatmap (loadgen claim_seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "volc-vmp"
      },
      "description": "Distribution over time of warm-sandbox checkout latency (SandboxClaim -> Ready).",
