# syntax=docker/dockerfile:1

# Image for cmd/sandbox-sdk-loadgen, the persistent-client create-latency
# benchmark that drives the writable aggregated apiserver (see deploy/loadgen-sdk/).
#   docker build -f Dockerfile.sdkloadgen -t <registry>/sandbox-sdk-loadgen:<tag> .

FROM --platform=$BUILDPLATFORM golang:1.27.0@sha256:4013ae0f9e7994f8535c58c811f8f863fbed38b72e0d51e6592156f758d66146 AS builder

ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY api/ ./api/
COPY cmd/ ./cmd/
COPY controllers/ ./controllers/
COPY extensions/ ./extensions/
COPY internal/ ./internal/
COPY pkg/ ./pkg/
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /sandbox-sdk-loadgen ./cmd/sandbox-sdk-loadgen

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
COPY --from=builder /sandbox-sdk-loadgen /sandbox-sdk-loadgen
ENTRYPOINT ["/sandbox-sdk-loadgen"]
